# Bu — NAMUNA. Nusxa oling va `.env` deb nomlang:
#   copy .env.example .env
#
# `.env` git'ga tushmaydi (.gitignore da), maxfiy ma'lumot xavfsiz.

# ==== MAJBURIY ====
# @BotFather dan olingan token
BOT_TOKEN=123456789:AAAA-BBBB-token-shu-yerga

# Asosiy adminlar. Telegram ID raqami, bir nechta bo'lsa vergul bilan.
# O'z ID'ingizni bilish uchun: @userinfobot ga /start yozing.
ADMIN_IDS=123456789

# ==== MA'LUMOT PAPKASI ====
# Baza, zaxira nusxalar va jurnal shu papkada saqlanadi:
#   DATA_DIR/rado_job.db
#   DATA_DIR/backups/
#   DATA_DIR/logs/
#
#   mahalliy kompyuter -> .
#   Railway            -> /data   (ulangan Volume, MAJBURIY)
#   VPS                -> .  yoki  /var/lib/rado-job
DATA_DIR=.

# Jurnal darajasi: INFO yoki DEBUG
LOG_LEVEL=INFO


# ==== QUYIDAGILAR IXTIYORIY ====
# Kanallar, moderatsiya chati, karta, to'lov summasi va bepul rejim
# BOT ICHIDAN sozlanadi:  🛠 Admin -> ⚙️ Sozlamalar
#
# Bu qatorlar faqat BIRINCHI ishga tushishda bazaga ko'chiriladi.
# Keyin bot ichidagi sozlamalar ustun turadi.
#
# CHANNEL_ID=
# MODERATION_CHAT_ID=
# CARD_NUMBER=
# CARD_HOLDER=
# DEFAULT_FEE=10000
# HOLD_MINUTES=15

# DB_URL ni faqat PostgreSQL ishlatganda yozing. Bo'sh bo'lsa bot
# DATA_DIR ichidagi SQLite faylini ishlatadi.
# DB_URL=postgresql+asyncpg://user:parol@host/rado_job
